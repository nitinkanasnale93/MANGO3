<!DOCTYPE html>
<html lang="en">
<head>

  <!-- Basic HTML settings -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mini Whatsapp</title>


   <script src="/app.js"></script>


  <!-- Link CSS -->
  <link rel="stylesheet" href="/style.css">

</head>


<body>

<h1><b>Mini Whatsapp</b></h1>

<form method="get" action="/chat/new">
    <button class="btn">New Chat</button>
</form>

<br/>

<div class="chats-container">

<% for(let chat of chats){ %>

   <div class="chat">

      <p>From: <%= chat.from %></p>

      <div class="msg">
         <p><%= chat.msg %></p>

         <form method="get" action="/chat/<%= chat._id %>/edit">
             <button>Edit</button>
             
         </form>
         <br/>

         <!-- <form method="POST" action="/chat/<%= chat._id %>?_method=DELETE">
             <button>Delete</button>
         </form> -->

         <form method="POST" action="/chat/<%= chat._id %>?_method=DELETE">
            <button onclick="confirmDelete(event)">Delete</button>
         </form>

      </div>

      <p>Received by: <%= chat.to %></p>

      <hr/>

   </div>

<% } %>

</div>

</body>
</html>