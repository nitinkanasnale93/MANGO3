<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write new chat</title>
</head>
<body>
    <h3>Write new chat</h3>

    <form method="POST" action="/chat">
        <input placeholder="who are you?" name="from" required>

        <br/><br/>

        <textarea name="msg" maxlength="50">Write your message here..</textarea>

        <br/><br/>

        <input placeholder="whom to send?" name="to" required>

        <br/><br/>

        <button>Create Chat</button>
    </form>
    
</body>
</html>
